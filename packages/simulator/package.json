{
  "name": "appium-ios-simulator",
  "version": "10.7.1",
  "description": "iOS Simulator interface for Appium.",
  "keywords": [
    "appium",
    "ios",
    "simctl",
    "simulator"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-ios/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-ios.git",
    "directory": "packages/simulator"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "rebuild": "npm run clean; npm run build",
    "dev": "npm run build -- --watch",
    "prepare": "npm run build",
    "test": "node --enable-source-maps --experimental-test-module-mocks --test --test-force-exit --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "test:e2e": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=3600000 \"./build/test/functional/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/coresim": "^1.11.1",
    "@appium/support": "^7.2.7",
    "@xmldom/xmldom": "^0.x",
    "appium-xcode": "^7.2.3",
    "async-lock": "^1.0.0",
    "asyncbox": "^6.4.3",
    "semver": "^7.8.5",
    "teen_process": "^4.2.0"
  },
  "devDependencies": {
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^26.0.0",
    "@types/sinon": "^22.0.0",
    "pem": "^1.8.3",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
