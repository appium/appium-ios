{
  "name": "@appium/media-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform native media transcoder that unifies device screen streams (HEVC) into the common H.264 / MJPEG format",
  "bugs": {
    "url": "https://github.com/appium/appium-ios/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-ios.git",
    "directory": "packages/media-proxy"
  },
  "files": [
    "src",
    "lib/src",
    "prebuilds",
    "scripts/install.mjs",
    "binding.gyp",
    "package.json",
    "README.md",
    "!.DS_Store",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf build node_modules lib",
    "build": "tsc -b",
    "build:addon": "node-gyp rebuild && node scripts/ci/bundle-libs.mjs --dest build/Release",
    "build:ffmpeg": "bash scripts/ci/build-ffmpeg.sh",
    "build:prebuilds": "node scripts/ci/build-prebuilds.mjs",
    "lint:cpp": "npm run build:compile-commands && bash scripts/ci/lint-cpp.sh",
    "format:cpp": "clang-format -i src/native/*.cc src/native/*.h",
    "format:cpp:check": "clang-format --dry-run --Werror src/native/*.cc src/native/*.h",
    "build:compile-commands": "node-gyp configure -- -f compile_commands_json",
    "install": "node scripts/install.mjs",
    "prepare": "npm run build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --enable-source-maps --test --test-force-exit --test-timeout=15000 \"lib/test/unit/**/*.spec.js\"",
    "test:integration": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=120000 \"lib/test/integration/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/support": "^7.2.9",
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@appium/tsconfig": "^1.2.0",
    "@types/node": "^26.6.5",
    "prebuildify": "^6.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "gypfile": true
}
